{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "e2e/**/*",
    "tools/**/*",
    "scripts/**/*",
    "../../types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "test-results"]
}
