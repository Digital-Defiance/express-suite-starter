{
  "name": "@digitaldefiance/express-suite-starter",
  "version": "6.0.0",
  "license": "MIT",
  "bin": {
    "create-express-suite": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "scaffolding",
    "config",
    "README.md"
  ],
  "scripts": {
    "start": "npx tsc && node dist/src/generate-monorepo.js",
    "create-project": "yarn start",
    "build": "npx tsc && chmod +x dist/src/cli.js",
    "build:prod": "NODE_ENV=production npx nx build digitaldefiance-express-suite-starter --configuration=production",
    "build:logged": "npx tsc 2>&1 | ansifilter -o build.log && chmod +x dist/src/cli.js",
    "lint": "npx eslint 'src/**/*.ts' 'tests/**/*.ts' 'e2e/**/*.ts' 'tools/**/*.ts' 'scripts/**/*.ts'",
    "lint:fix": "npx eslint 'src/**/*.ts' 'tests/**/*.ts' 'e2e/**/*.ts' 'tools/**/*.ts' 'scripts/**/*.ts' --fix",
    "typecheck": "npx tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npx jest",
    "test:all": "yarn typecheck && yarn test",
    "test:network": "RUN_TRANSLATION_TESTS=true NODE_OPTIONS=--experimental-vm-modules npx jest tests/integration/translation-providers.spec.ts",
    "test:unit": "npx jest tests/unit",
    "test:integration": "npx jest tests/integration",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "test:logged": "npx jest 2>&1 | ansifilter -o test.log",
    "sync-templates": "npx ts-node tools/sync-templates.ts",
    "prepublishOnly": "yarn build && yarn lint && yarn typecheck && yarn test",
    "publish:public": "npm publish --access public"
  },
  "dependencies": {
    "@digitaldefiance/i18n-lib": "^4.8.0",
    "@inquirer/checkbox": "^4.3.2",
    "@inquirer/confirm": "^5.1.21",
    "@inquirer/input": "^4.3.1",
    "@inquirer/prompts": "^7.5.0",
    "@inquirer/select": "^4.4.2",
    "chalk": "^4.1.2",
    "handlebars": "^4.7.8",
    "mustache": "^4.2.0",
    "validator": "^13.15.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-translate": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@digitaldefiance/express-suite-test-utils": "^1.1.2",
    "@nx/js": "22.0.2",
    "@nx/workspace": "22.0.2",
    "@playwright/test": "^1.52.0",
    "@types/jest": "^29.5.0",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.0.0",
    "@types/validator": "^13.15.0",
    "jest": "^29.7.0",
    "nx": "22.0.2",
    "otplib": "13.4.0",
    "plop": "^4.0.1",
    "prettier": "^3.5.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.11.0"
}
